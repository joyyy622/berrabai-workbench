# Copy to .env, replace the password, then load it in your shell:
# set -a
# source .env
# set +a
# The Python server does not automatically read .env.
ADMIN_PASSWORD='replace-with-your-own-long-password'
PORT=8765
AI_PROVIDER=local
LOCAL_MODEL=qwen3:4b

# Optional independent database. Parent directory must exist.
# WORKBENCH_DB=./berrabai.sqlite3

# Optional OpenAI-compatible remote model (instead of local Ollama).
# AI_PROVIDER=remote
# AI_BASE_URL=https://your-provider.example/v1
# AI_MODEL=your-provider-model-id
# AI_API_KEY=replace-locally-never-commit
